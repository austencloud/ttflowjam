		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^26.2.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.0.0",
		"jsdom": "^29.0.0",
		"postcss-html": "^1.7.0",
