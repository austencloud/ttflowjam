{
	"name": "ttflowjam",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write \"**/*.{js,ts,svelte,json,md,css}\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"gallery:build": "node scripts/build-gallery-from-album.mjs",
		"gallery:upload": "node scripts/upload-gallery-r2.mjs",
		"gallery:verify": "node scripts/verify-gallery.mjs harvest/gallery-build"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260901.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^26.2.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.0.0",
		"exifr": "^7.1.3",
		"jsdom": "^29.0.0",
		"postcss-html": "^1.7.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.3.0",
		"sharp": "^0.35.4",
		"stylelint": "^16.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^6.0.0",
		"vitest": "^4.0.0",
		"wrangler": "^4.70.0"
	},
	"dependencies": {
		"@austencloud/media-spotlight": "file:vendor/austencloud-media-spotlight-1.0.3.tgz",
		"csv-parse": "^7.0.2",
		"jose": "^6.2.10"
	}
